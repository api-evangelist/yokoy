            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.yokoy.ai/v1/organizations/{organizationId}/legal-entities/:legalEntityId/invoice-purchase-orders",
            "headers": [
              {
                "name": "X-Yk-Auth-Method",
