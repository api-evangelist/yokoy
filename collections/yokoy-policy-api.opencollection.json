                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Creates a new employee policy and returns the created entity."
        },
        {
          "info": {
            "name": "Get a policy by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.yokoy.ai/v1/organizations/{organizationId}/legal-entities/:legalEntityId/policies/:policyId",
            "headers": [
              {
                "name": "X-Yk-Auth-Method",
