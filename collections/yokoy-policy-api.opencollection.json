              },
              {
                "name": "policyId",
                "value": "06x2u4nagAMEq3gGoMch",
                "type": "path",
                "description": "Yokoy unique ID of the employee policy."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://accounts[.test].yokoy.ai/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
