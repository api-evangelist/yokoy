          "info": {
            "name": "Create a supplier (organization)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.yokoy.ai/v1/organizations/{organizationId}/suppliers",
            "headers": [
              {
                "name": "X-Yk-Auth-Method",
