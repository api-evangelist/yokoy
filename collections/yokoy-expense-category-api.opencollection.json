                "description": "Yokoy unique ID of the legal entity (company)."
              },
              {
                "name": "categoryId",
                "value": "1WOspYIfp6",
                "type": "path",
                "description": "Yokoy unique ID of the expense category."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://accounts[.test].yokoy.ai/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
