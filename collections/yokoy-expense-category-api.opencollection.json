                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Creates a new category for the legal entity specified by its Yokoy unique ID in the path. It returns the created entity."
        },
        {
          "info": {
            "name": "Get an expense category by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.yokoy.ai/v1/organizations/{organizationId}/legal-entities/:legalEntityId/categories/:categoryId",
            "headers": [
